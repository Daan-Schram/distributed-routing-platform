# Setup per VM

# All VMs
KAFKA_BOOTSTRAP_SERVERS=<KAFKA_IP>:9092
AGENT_API_KEY=random-key
VM_ID=vm<x>

# Sumo1 only
AGENT_LAYER1_URL=http://localhost:8001
AGENT_LAYER2_URL=http://<KAFKA_IP>:8002
AGENT_LAYER3_URL=http://<ACTORS1_IP>:8003
AGENT_LAYER4_URL=http://<LEARNER_IP>:8004
AGENT_LAYER3_EXTRA_URLS=http://<ACTORS2_IP>:8003,http://<ACTORS3_IP>:8003

# Simulation VMs (sumo1)
# SUMO_HOME=/usr/share/sumo
DISPLAY_VNC_PASS=change-me

# Kafka VM
KAFKA_HOST=<KAFKA_IP>
